[Unit]
Description=NTP Server Web GUI
After=network.target

[Service]
Type=simple
User=ntp-admin
WorkingDirectory=/opt/ntp-server-webgui
ExecStart=/opt/ntp-server-webgui/.venv/bin/python /opt/ntp-server-webgui/app.py
Restart=on-failure
RestartSec=5

# Ensure Python output is immediately flushed to journal
Environment=PYTHONUNBUFFERED=1
Environment=SANDBOX_MODE=false
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=5000
EnvironmentFile=-/opt/ntp-server-webgui/runtime.env
Environment=NTP_SERVICE_NAMES=chrony

# Grant permission to manage network interfaces and services, and keep the
# capabilities needed for sudo to switch from the NTP user to root.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_BOOT CAP_SETGID CAP_SETUID CAP_AUDIT_WRITE
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_BOOT CAP_SETGID CAP_SETUID CAP_AUDIT_WRITE
SecureBits=keep-caps

[Install]
WantedBy=multi-user.target
